<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resolution_Minutes__c</fullName>
    <label>Resolution Minutes</label>
    <type>Number</type>
    <formula>IF(ISBLANK(Resolved_At__c), NULL, ROUND((Resolved_At__c - CreatedDate) * 1440, 0))</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <precision>10</precision>
    <scale>0</scale>
</CustomField>
